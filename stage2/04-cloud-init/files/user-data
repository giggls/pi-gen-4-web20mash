#  owner: root:root
#  permissions: '0644'

## Finally prepare for readonly image:
## * Mask unnecessary stuff like cron, timers and cloud-init
## * Enable readonly mode and reboot.
runcmd:
- [ /usr/bin/systemctl, mask, cloud-init.target ]
- [ /usr/bin/systemctl, mask, cloud-init-main.service ]
- [ /usr/bin/systemctl, mask, cloud-init-local.service ]
- [ /usr/bin/systemctl, mask, cloud-init-network.service ]
- [ /usr/bin/systemctl, mask, modprobe@drm.service ]
- [ /usr/bin/systemctl, mask, systemd-remount-fs.service ]
- [ /usr/bin/systemctl, mask, cron.service ]
- [ /usr/bin/systemctl, mask, apt-daily-upgrade.timer ]
- [ /usr/bin/systemctl, mask, apt-daily.timer ]
- [ /usr/bin/systemctl, mask, dpkg-db-backup.timer ]
- [ /usr/bin/systemctl, mask, e2scrub_all.timer ]
- [ /usr/bin/systemctl, mask, fstrim.timer ]
- [ /usr/bin/systemctl, mask, logrotate.timer ]
- [ /usr/bin/systemctl, mask, man-db.timer ]
- [ /usr/bin/systemctl, mask, systemd-tmpfiles-clean.timer ]
- [ /usr/bin/raspi-config, nonint, enable_bootro ]
- [ /usr/bin/raspi-config, nonint, enable_overlayfs ]
- [ /usr/bin/sleep, 2 ]
- [ /sbin/reboot ]
